# Environment Configuration Template
# Copy this file to .env and populate your actual values.
# NEVER commit the real .env file into Git.

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite:///./database/vedam.db
# For Production PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/vedic_heritage_db

# Collection & Crawler Settings
DEFAULT_REQUEST_DELAY_SECONDS=2.0
USER_AGENT=VedicHeritageResearchBot/1.0 (+https://vedam.org/bot-info)
MAX_RETRIES=3
TIMEOUT_SECONDS=30

# Gemini / AI Integration
GEMINI_API_KEY=

# Security & Admin Backend (Phase 13)
SECRET_KEY=replace_with_a_secure_random_key
API_PORT=8000
